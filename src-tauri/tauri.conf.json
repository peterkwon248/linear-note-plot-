{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Plot",
  "version": "0.1.0",
  "identifier": "com.plot.desktop",
  "build": {
    "frontendDist": "../out",
    "beforeBuildCommand": "npx next build --webpack"
  },
  "app": {
    "windows": [
      {
        "title": "Plot",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Plot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
